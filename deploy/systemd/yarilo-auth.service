[Unit]
Description=yarilo authentication service
Documentation=https://doc.yarilomail.org/
PartOf=yarilo.target
After=network.target yarilo-locks.service

[Service]
Type=simple
User=yarilo-auth
Group=yarilo-auth
SupplementaryGroups=yarilo-master
Environment=TELEMETRY_LISTEN=127.0.0.1:18081
# The users database password, readable by this unit alone: /etc/yarilo/auth.env.
EnvironmentFile=-/etc/yarilo/auth.env
ExecStart=/usr/libexec/yarilo/yarilo-auth
ExecStartPost=/bin/sh -c 'i=0; until [ -S /run/yarilo/auth/auth-client.sock ] && [ -S /run/yarilo/auth/auth-master.sock ]; do i=$$((i+1)); [ $$i -gt 50 ] && exit 1; sleep 0.2; done'
Restart=on-failure
RestartSec=2s
KillMode=mixed
TimeoutStopSec=60s
CapabilityBoundingSet=
ReadWritePaths=/run/yarilo/auth /var/lib/yarilo/auth
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=yarilo.target
